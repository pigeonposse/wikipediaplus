{
	"name": "wikipediaplus",
	"version": "1.2.1",
	"description": "WikipediaPlus is an extension that allows you to quickly and efficiently access all relevant links on the page you're visiting.",
	"manifest_version": 2,
	"icons": {
		"96": "../icon-96.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "{a2e191e8-b8eb-490b-b282-9f3d2c0332bf}",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	},
	"content_scripts": [
		{
			"matches": [
				"https://wikipedia.org/*",
				"https://*.wikipedia.org/*"
			],
			"js": [
				"../content.js"
			],
			"css": [
				"../content.css"
			],
			"run_at": "document_end"
		}
	]
}
